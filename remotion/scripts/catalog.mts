// Builds CATALOG.md + docs/gallery/: a still and the props of every shared composition.
// Run after adding or changing a shared component:  npm run catalog [-- <id> …]  (ids = only re-render those stills)
// Plain Node runs this file directly (type stripping); it reads the props from src/schemas.ts.
import { bundle } from "@remotion/bundler";
import { getCompositions, renderStill } from "@remotion/renderer";
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { z } from "zod";
import { catalog, schemas } from "../src/schemas.ts";

const ROOT = path.resolve(import.meta.dirname, "..");
const GALLERY = path.join(ROOT, "docs", "gallery");
const BG = "0x3a3f4b"; // stills have alpha; flatten onto a neutral grey so white text shows on GitHub
const env = { REMOTION_GALLERY: "1" }; // neutral brand, whoever runs it
const only = process.argv.slice(2);

type JS = { type?: string | string[]; enum?: unknown[]; items?: JS; anyOf?: JS[]; description?: string; properties?: Record<string, JS>; required?: string[] };
const typeOf = (j: JS): string => {
  if (j.enum) return j.enum.map((v) => JSON.stringify(v)).join(" | ");
  if (j.anyOf) return j.anyOf.map(typeOf).join(" | ");
  if (j.type === "array") return `${j.items ? typeOf(j.items) : "any"}[]`;
  if (j.type === "object") return j.properties ? `{ ${Object.keys(j.properties).join(", ")} }` : "object";
  return (Array.isArray(j.type) ? j.type.join(" | ") : j.type) ?? "any";
};
const cell = (s: string) => s.replace(/\|/g, "\\|").replace(/\n/g, " ");

fs.mkdirSync(GALLERY, { recursive: true });
console.log("bundling…");
const serveUrl = await bundle({ entryPoint: path.join(ROOT, "src", "index.ts") });
const comps = await getCompositions(serveUrl, { envVariables: env });

const sections: string[] = [];
const grid: string[] = [];
for (const [id, entry] of Object.entries(catalog)) {
  const c = comps.find((x) => x.id === id);
  if (!c) throw new Error(`${id} is in the catalog but not registered in Root.tsx`);
  const jpg = `docs/gallery/${id}.jpg`;
  if (!only.length || only.includes(id)) {
    const png = path.join(GALLERY, `${id}.png`);
    const frame = Math.min(c.durationInFrames - 1, Math.round(c.durationInFrames * (entry.still ?? 0.5)));
    // Node APIs ignore remotion.config.ts: ask for PNG (alpha) explicitly, like the config's png/ProRes 4444 default.
    await renderStill({ composition: c, serveUrl, output: png, frame, envVariables: env, inputProps: c.defaultProps, imageFormat: "png" });
    const w = c.width > c.height ? 480 : 270;
    execFileSync("ffmpeg", ["-loglevel", "error", "-y", "-f", "lavfi", "-i", `color=c=${BG}:s=${c.width}x${c.height}`, "-i", png,
      "-filter_complex", `[0][1]overlay,scale=${w}:-2`, "-frames:v", "1", "-q:v", "4", path.join(ROOT, jpg)]);
    fs.rmSync(png);
    console.log("still:", id);
  }
  const js = z.toJSONSchema(schemas[entry.component], { unrepresentable: "any" }) as JS;
  const rows = Object.entries(js.properties ?? {}).map(([k, p]) =>
    `| \`${k}\` | ${cell(typeOf(p))} | ${js.required?.includes(k) ? "✔" : ""} | ${cell(p.description ?? "")} |`);
  grid.push(`<a href="#${id.toLowerCase()}"><img src="${jpg}" height="160" alt="${id}"></a>`);
  sections.push([
    `## ${id}`,
    `<img src="${jpg}" align="right" width="${c.width > c.height ? 320 : 180}">`,
    "",
    `${entry.about}  `,
    `\`${c.width}×${c.height}\` · ${c.fps} fps · component \`${entry.component}\``,
    "",
    "| prop | type | required | notes |",
    "|---|---|---|---|",
    ...rows,
    "",
    "Example:",
    "```bash",
    `npx remotion render ${id} out.mov --props='${JSON.stringify(c.defaultProps)}'`,
    "```",
    '<br clear="right">',
  ].join("\n"));
}

const md = `# Graphics catalog

<!-- generated by \`npm run catalog\` from src/schemas.ts — don't edit by hand -->

Every shared graphic, with its props. Each renders with transparency (ProRes 4444 — the default in
\`remotion.config.ts\`, no flags needed; render to a \`.mov\`) and goes on a track above the edit in Premiere.
Colours and the channel name fall back to \`brand.json\` when not passed. \`seconds\` sets a clip's length;
everything renders at 60 fps unless you set \`REMOTION_FPS\` (e.g. \`REMOTION_FPS=30 npx remotion render …\`).

${grid.join("\n")}

${sections.join("\n\n")}
`;
fs.writeFileSync(path.join(ROOT, "CATALOG.md"), md);
console.log(`CATALOG.md: ${sections.length} compositions`);
