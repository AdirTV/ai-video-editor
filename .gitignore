.venv/
__pycache__/
node_modules/
.DS_Store
# personal: each person keeps their own
style.md
vocab.txt
brand.json
# media and outputs never go in the repo
remotion/public/*
!remotion/public/.gitkeep
# shared assets the components need (placeholders, emoji); add-on assets are copied in from plugins/
!remotion/public/core/
!remotion/public/lottie/
# your own per-video graphics and their media stay local
remotion/src/projects/*
!remotion/src/projects/README.md
remotion/out/
*.mp4
*.mov
*.wav
*.mp3
*_analysis/
test/
# personal branding files (top-level only)
/brand/
# add-ons: each is its own folder (often its own repo), see plugins/README.md
/plugins/*
!/plugins/README.md
